# Recorded checksums depend on exact bytes, so line endings stay LF on every checkout.
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf

# The pilot evaluation lock recorded this file with CRLF endings.
docs/pilot/prepared-release.json text eol=crlf

# Go and SQL sources
*.go text eol=lf
*.sql text eol=lf
