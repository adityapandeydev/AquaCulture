  "rules": {
    "independent_site_holdout": "Development and test must have disjoint known lineage/study groups AND affirmative physical-site independence evidence; disjoint IDs alone do not suffice.",
    "chronological_within_study": "Shared study/lineage is allowed only with disjoint source observation identities and target periods, issue-time-available history, no boundary-crossing training labels and source/session/quality approval.",
    "copied_observations": "One originating observation and its derivatives/copies cannot supply independent train/test labels. Keep one canonical representation with complete parent lineage.",
    "raw_and_aggregate": "Aggregates and raw parents are dependent representations, not independent holdout sources.",
    "unknown_independence": "Do not infer separate sites from filenames, pond labels or a continuity-gap boundary.",
    "new_sources": "Uncataloged source fails release admission until provenance, identity, reuse, quality and overlap reviews complete."
  },
